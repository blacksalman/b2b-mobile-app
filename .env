# Medusa backend (apps/backend in B2b_Backend_On_Medusa) this app talks to.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time - fine here since a
# "publishable" API key is meant to be shipped in a client app (it only scopes requests to
# a sales channel, it grants no write access), same as Medusa's own storefronts do.
#
# Must be the dev machine's LAN IP, not localhost, when testing on a physical phone via Expo
# Go - the phone's own "localhost" means the phone itself, not this PC, so it can never reach
# a backend at localhost:9000. This only needs to change if your PC's LAN IP changes (e.g. new
# WiFi network) - find it with `ipconfig` (look for the Wi-Fi adapter's IPv4 Address). Revert to
# http://localhost:9000 if you go back to testing only in a browser on this same machine.
EXPO_PUBLIC_MEDUSA_BACKEND_URL=http://192.168.31.144:9000
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_0983c977d60ecfb06de21650d4efb751a5ec12152ffeda92803a3a3c836ab7be
EXPO_PUBLIC_MEDUSA_REGION_ID=reg_01KXGZ04SNF8W95DVR209R9E0P
