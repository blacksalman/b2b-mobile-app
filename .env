# Medusa backend (apps/backend in B2b_Backend_On_Medusa) this app talks to.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time - fine here since a
# "publishable" API key is meant to be shipped in a client app (it only scopes requests to
# a sales channel, it grants no write access), same as Medusa's own storefronts do.
#
# Currently an ngrok tunnel (apps/backend: `npx ngrok http 9000`) so the app works from any
# network, not just this Wi-Fi - needed for testing from a phone that isn't on the same network
# as this PC. ngrok's free tier reassigns this URL on every restart (this one's pinned to a
# reserved domain, so it stays the same across restarts here, but confirm it's still online -
# `curl http://127.0.0.1:4040/api/tunnels` - before assuming it's live). For same-Wi-Fi-only
# testing, this can go back to the LAN IP instead (http://192.168.31.144:9000 as of this
# writing, find it with `ipconfig` -> Wi-Fi adapter's IPv4 Address); for a browser on this same
# PC, http://localhost:9000.
EXPO_PUBLIC_MEDUSA_BACKEND_URL=https://flatfoot-habitable-vehicular.ngrok-free.dev
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_0983c977d60ecfb06de21650d4efb751a5ec12152ffeda92803a3a3c836ab7be
EXPO_PUBLIC_MEDUSA_REGION_ID=reg_01KXGZ04SNF8W95DVR209R9E0P
